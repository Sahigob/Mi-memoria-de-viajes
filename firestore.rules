rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede leer y modificar sus propios establecimientos.
    match /users/{userId}/places/{placeId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Solo el correo destinatario puede abrir el enlace compartido.
    // Los enlaces no se pueden listar, modificar ni borrar desde la aplicación.
    match /sharedPlaces/{shareId} {
      allow get: if request.auth != null
        && request.auth.token.email == resource.data.recipientEmail;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.recipientEmail is string
        && request.resource.data.place is map;
      allow update, delete: if false;
    }

    // Cualquier otra ruta queda cerrada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}