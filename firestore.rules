rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/places/{placeId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    // Directorio mínimo: UID y nombre visible, sin direcciones de correo.
    match /appUsers/{userId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["uid", "displayName", "createdAt"])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "updatedAt"])
        && request.resource.data.displayName is string;
      allow delete: if false;
    }
    // Solo la cuenta destinataria puede abrir un enlace compartido.
    match /sharedPlaces/{shareId} {
      allow get: if request.auth != null && request.auth.uid == resource.data.recipientUid;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.place is map;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}