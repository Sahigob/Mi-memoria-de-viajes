rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede leer y modificar sus propios establecimientos.
    match /users/{userId}/places/{placeId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Un enlace compartido permite consultar una ficha concreta, pero no listar,
    // modificar ni borrar los enlaces. El ID aleatorio actúa como clave del enlace.
    match /sharedPlaces/{shareId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.place is map;
      allow update, delete: if false;
    }

    // Cualquier otra ruta queda cerrada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}